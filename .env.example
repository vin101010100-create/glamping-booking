# Скопируйте файл в .env и при необходимости измените значения.

# Секретный ключ Flask (обязательно замените в production).
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL. Если строка закомментирована, используется локальный SQLite
# (instance/glamping.db) — удобно для первого запуска и демонстрации.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/glamping
